{
  "expo": {
    "name": "Oikonome",
    "slug": "oikonome",
    "version": "1.2.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "oikonome",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f141a",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "bundleIdentifier": "org.example.oikonome",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f141a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "package": "org.example.oikonome",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-android-hardening.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f141a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4f9bd6"
        }
      ],
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach a photo of a receipt to a transaction, so the line items live with the charge.",
          "cameraPermission": "Photograph a receipt to attach it to a transaction, so the line items live with the charge."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Oikonome with Face ID so your financial data stays behind the same lock as your phone."
        }
      ],
      "./plugins/with-android-upload-signing.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {}
    }
  }
}
